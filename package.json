{
  "name": "dinnafind",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "clear:asyncstorage": "node ./scripts/clearAsyncStorage.js",
    "clear:redux": "node ./scripts/clearReduxPersist.js",
    "reset:all": "npm run clear:asyncstorage && npm run clear:redux && npm run start:clear",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "version:patch": "bun run version:bump patch",
    "version:minor": "bun run version:bump minor",
    "version:major": "bun run version:bump major",
    "version:bump": "node ./scripts/version-bump.js",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev": "eas build --platform all --profile development",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview": "eas build --platform all --profile preview",
    "build:prod:ios": "eas build --platform ios --profile production",
    "build:prod:android": "eas build --platform android --profile production",
    "build:prod": "eas build --platform all --profile production",
    "build:prod-local:ios": "eas build --platform ios --profile production-local --local",
    "build:prod-local:android": "eas build --platform android --profile production-local --local",
    "build:prod-local": "eas build --platform all --profile production-local --local",
    "submit:preview:ios": "source .env.local && eas submit --platform ios --profile preview",
    "submit:preview:android": "source .env.local && eas submit --platform android --profile preview",
    "submit:prod:ios": "source .env.local && eas submit --platform ios --profile production",
    "submit:prod:android": "source .env.local && eas submit --platform android --profile production",
    "submit:testflight": "source .env.local && eas submit --platform ios --profile testflight",
    "release:preview": "bun run build:preview && bun run submit:preview:ios && bun run submit:preview:android",
    "release:production": "bun run build:prod && bun run submit:prod:ios && bun run submit:prod:android",
    "update:preview": "eas update --branch preview --message \"Preview update\"",
    "update:production": "eas update --branch production --message \"Production update\"",
    "update:hotfix": "eas update --branch production --message \"Hotfix\" --clear-cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.5.2",
    "@react-navigation/native": "^7.1.6",
    "@reduxjs/toolkit": "^2.8.2",
    "@rneui/themed": "^4.0.0-rc.8",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.50.3",
    "@types/react-test-renderer": "^19.1.0",
    "ajv": "^8.0.0",
    "dotenv": "^17.2.1",
    "expo": "^54.0.30",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.15",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.15",
    "expo-web-browser": "~15.0.10",
    "ios": "^0.0.1",
    "querystring-es3": "^0.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "^4.0.13",
    "react-native": "0.81.5",
    "react-native-branch": "^6.7.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "redux-devtools-expo-dev-plugin": "^2.0.0",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.3.0",
    "watch": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "ajv-keywords": "^5.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.30.1",
    "eslint-config-expo": "~10.0.0",
    "husky": "^8.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.16",
    "metro-minify-terser": "^0.80.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-branch",
          "@rneui/themed",
          "redux-persist",
          "ajv",
          "dotenv",
          "ios",
          "querystring-es3",
          "redux-devtools-expo-dev-plugin",
          "redux-saga",
          "watch"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/test-utils/setup.ts"],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/__mocks__/**",
      "!**/__fixtures__/**",
      "!**/test-utils/**"
    ],
    "testTimeout": 10000
  },
  "private": true
}