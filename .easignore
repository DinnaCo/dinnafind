# EAS Build Ignore File
# This file tells EAS which files and directories to exclude during builds

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# Development files
.env
.env.local
.env.production.local
.env.example
*.log
*.tsbuildinfo

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentation
docs/
README.md
CHANGELOG.md
RELEASE_CHECKLIST.md
TOKENS_SECRETS.md

# Scripts and tools
scripts/
.husky/
.eslintrc*
.prettierrc*
.eslintignore
.prettierignore
.expo/
